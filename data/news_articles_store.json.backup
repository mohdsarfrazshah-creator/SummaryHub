      "isUpdate": false,
      "readingTimeMinutes": 5,
      "thumbnailUrl": "https://i.guim.co.uk/img/media/c17650b0b1b1a81af75655536b8a8313e321e113/284_0_2582_2066/master/2582.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=dcb7909eeac8b63cab6730588a7a793c&quality=85&auto=format&fit=max",
