idth%3D%226%22%20height%3D%2248%22%20rx%3D%223%22%20fill%3D%22url(%23accentGrad)%22%2F%3E%0A%20%20%20%20%3Ctext%20x%3D%22100%22%20y%3D%22114%22%20font-family%3D%22system-ui%2C%20-apple-system%2C%20sans-serif%22%20font-size%3D%2222%22%20font-weight%3D%22700%22%20fill%3D%22%236366f1%22%20letter-spacing%3D%223%22%3EINTERNATIONAL%20NEWS%3C%2Ftext%3E%0A%20%20%20%20%0A%20%20%20%20%3Ctext%20x%3D%2280%22%20y%3D%22340%22%20font-family%3D%22'Newsreader'%2C%20Georgia%2C%20serif%22%20font-size%3D%2238%22%20font-weight%3D%22700%22%20fill%3D%22%23f8fafc%22%20width%3D%221120%22%3EWhite%20House%20announces%20funds%20for%20law%20enforcement%20program%3C%2Ftext%3E%0A%20%20%20%20%3Ctext%20x%3D%2280%22%20y%3D%22405%22%20font-family%3D%22'Cinzel'%2C%20'Newsreader'%2C%20Georgia%2C%20serif%22%20font-size%3D%2219%22%20fill%3D%22%23c5a059%22%20letter-spacing%3D%221%22%3ETHE%20WORLD%20LEDGER%20%26bull%3B%20VERIFIED%20INTERNATIONAL%20DISPATCH%3C%2Ftext%3E%0A%20%20%20%20%0A%20%20%20%20%3Cline%20x1%3D%2280%22%20y1%3D%22590%22%20x2%3D%221200%22%20y2%3D%22590%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.08)%22%20stroke-width%3D%221%22%2F%3E%0A%20%20%20%20%3Ctext%20x%3D%2280%22%20y%3D%22630%22%20font-family%3D%22system-ui%2C%20-apple-system%2C%20sans-serif%22%20font-size%3D%2215%22%20fill%3D%22%2364748b%22%3EVerified%20dispatch%20details%20and%20primary%20source%20reference%20available%20in%20briefing%3C%2Ftext%3E%0A%20%20%3C%2Fsvg%3E",
