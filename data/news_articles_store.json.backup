      "thumbnailUrl": "https://i.guim.co.uk/img/media/1c4580d488b642cc82530f9cfaed8894a6f3bfa3/458_0_6361_5089/master/6361.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=a00a6dd715c63983135cded15c06b146&quality=85&auto=format&fit=max",
      "originalImageUrl": "https://i.guim.co.uk/img/media/1c4580d488b642cc82530f9cfaed8894a6f3bfa3/458_0_6361_5089/master/6361.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=a00a6dd715c63983135cded15c06b146&quality=85&auto=format&fit=max",
