    {
      "id": "art-guardian_world-mvpeg0ph-t0up",
      "title": "UK poised to miss reduced aid spending target of 0.3% of national income",
      "description": "<p>Calculations from the Center for Global Development say spending next year is likely to be £410m less than anticipated</p><p>The UK is on course to miss its target of spending 0.3% of national income on international aid by an estimated £400m by the end of next year.</p><p>Calculations from the Center for Global Development (CGD) found the UK was on course for a large shortfall in promised official development assistance at the end of 2027.</p> <a href=\"https://www.theguardian.com/politics/2026/oct/26/uk-international-aid-target-spending-shortfall-budget-research\">Continue reading...</a>",
      "canonicalUrl": "https://www.theguardian.com/politics/2026/oct/26/uk-international-aid-target-spending-shortfall-budget-research",
      "originalUrl": "https://www.theguardian.com/politics/2026/oct/26/uk-international-aid-target-spending-shortfall-budget-research",
      "publisherId": "guardian_world",
      "creatorId": "guardian_world",
      "creatorName": "The Guardian World",
      "creatorHandle": "@guardianworld",
      "creatorAvatar": "https://images.unsplash.com/photo-1585829365295-ab7cd400c167?w=120&auto=format&fit=crop&q=80",
      "platform": "news",
      "category": "Current Affairs",
      "currentAffairsCategory": "World News",
      "publishDate": "2026-10-26T06:59:36.000Z",
      "publishedAt": "2026-10-26T06:59:36.000Z",
      "firstSeenAt": "2026-10-26T15:16:18.977Z",
      "lastCheckedAt": "2026-10-26T15:23:12.047Z",
      "contentHash": "13338bbc805b9992",
