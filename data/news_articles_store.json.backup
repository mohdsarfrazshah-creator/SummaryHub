      "id": "art-bbc_sport-mvxd7tp9-2h6y",
      "title": "Centre Hawkins determined to make World Cup",
      "description": "Wales centre Joe Hawkins says missing the previous World Cup has made him more determined to make the next global tournament in Australia in 12 months.",
      "canonicalUrl": "https://www.bbc.co.uk/sport/rugby-union/articles/c8vgx0yn4kv0o?at_medium=RSS&at_campaign=rss",
      "originalUrl": "https://www.bbc.co.uk/sport/rugby-union/articles/c8vgx0yn4kv0o?at_medium=RSS&at_campaign=rss",
      "publisherId": "bbc_sport",
      "creatorId": "bbc_sport",
