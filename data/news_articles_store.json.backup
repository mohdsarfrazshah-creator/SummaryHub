      "contentHash": "a0b92d04b39baf0f",
      "isUpdate": false,
      "readingTimeMinutes": 5,
      "thumbnailUrl": "https://i.guim.co.uk/img/media/b301f74044f07fd68f8f818d6f4057bea7503067/694_226_4041_3233/master/4041.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=594c33186e1bead70ac2f0f6777e27b1&quality=85&auto=format&fit=max",
      "originalImageUrl": "https://i.guim.co.uk/img/media/b301f74044f07fd68f8f818d6f4057bea7503067/694_226_4041_3233/master/4041.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=594c33186e1bead70ac2f0f6777e27b1&quality=85&auto=format&fit=max",
