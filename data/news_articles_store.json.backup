      "firstSeenAt": "2026-10-26T14:17:38.369Z",
      "lastCheckedAt": "2026-11-01T05:04:08.074Z",
      "contentHash": "b4ef4327c7b42e01",
      "isUpdate": false,
      "readingTimeMinutes": 2,
      "thumbnailUrl": "https://www.sciencedaily.com/images/1920/human-heart-with-red-cardio-pulse-close.webp",
      "originalImageUrl": "https://www.sciencedaily.com/images/1920/human-heart-with-red-cardio-pulse-close.webp",
      "imageSource": "publisher",
