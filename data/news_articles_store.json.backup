      "creatorId": "wired",
      "creatorName": "Wired",
      "creatorHandle": "@wired",
      "creatorAvatar": "https://images.unsplash.com/photo-1518770660439-4636190af475?w=120&auto=format&fit=crop&q=80",
      "platform": "news",
      "category": "Technology",
      "currentAffairsCategory": "Science & Technology",
      "publishDate": "2026-11-08T12:00:00.000Z",
      "publishedAt": "2026-11-08T12:00:00.000Z",
      "firstSeenAt": "2026-11-11T04:40:41.119Z",
