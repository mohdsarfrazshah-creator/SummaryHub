      "thumbnailUrl": "https://i.guim.co.uk/img/media/f292b2a2ce94ce0fdfdabbda589c1b0008b1475e/1862_969_4674_3739/master/4674.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=14c71afcd05b03f73c50f3912371c515&quality=85&auto=format&fit=max",
      "originalImageUrl": "https://i.guim.co.uk/img/media/f292b2a2ce94ce0fdfdabbda589c1b0008b1475e/1862_969_4674_3739/master/4674.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=14c71afcd05b03f73c50f3912371c515&quality=85&auto=format&fit=max",
