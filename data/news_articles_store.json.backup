      "originalImageUrl": "https://i.guim.co.uk/img/media/1b19f74ad6b0d65006694290ccf99ff869eb1d3e/438_59_3273_2618/master/3273.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=f1da9529d1f50da543e888a4bd37c6de&quality=85&auto=format&fit=max",
      "imageSource": "publisher",
