      "currentAffairsCategory": "World News",
      "publishDate": "2026-10-31T15:00:45.000Z",
      "publishedAt": "2026-10-31T15:00:45.000Z",
      "firstSeenAt": "2026-11-01T04:59:20.856Z",
      "lastCheckedAt": "2026-11-01T05:04:10.395Z",
      "contentHash": "4e73a015f3a5cde2",
