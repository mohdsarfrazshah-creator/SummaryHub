      "contentHash": "1be904e5cd3a0410",
      "isUpdate": false,
      "readingTimeMinutes": 5,
      "thumbnailUrl": "https://i.guim.co.uk/img/media/b30015cff08ff85e307676e1f7c02162cd8ea21d/510_0_3000_2400/master/3000.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=4162951dccef62386499fa4daa5c39ed&quality=85&auto=format&fit=max",
      "originalImageUrl": "https://i.guim.co.uk/img/media/b30015cff08ff85e307676e1f7c02162cd8ea21d/510_0_3000_2400/master/3000.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=4162951dccef62386499fa4daa5c39ed&quality=85&auto=format&fit=max",
      "imageSource": "publisher",
