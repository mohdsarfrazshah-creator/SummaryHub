      "currentAffairsCategory": "World News",
      "publishDate": "2026-11-09T02:11:25.000Z",
      "publishedAt": "2026-11-09T02:11:25.000Z",
      "firstSeenAt": "2026-11-11T04:40:45.813Z",
      "lastCheckedAt": "2026-11-11T05:12:55.627Z",
      "contentHash": "7e244567081202ca",
      "isUpdate": false,
