      "readingTimeMinutes": 2,
      "thumbnailUrl": "https://media.wired.com/photos/6aee77f4ece1c19963602401/master/pass/gear-nyt-cooking-ai-assistant.jpg",
      "originalImageUrl": "https://media.wired.com/photos/6aee77f4ece1c19963602401/master/pass/gear-nyt-cooking-ai-assistant.jpg",
      "imageSource": "publisher",
      "imageType": "photo",
      "imageCaption": "Official photograph from Wired for \"I Used NYT Cooking’s New AI-Powered Recipe Modifier, and It’s Actually Pretty Good\"",
      "imageAttribution": "Source: Wired",
      "imageValidationStatus": "valid",
