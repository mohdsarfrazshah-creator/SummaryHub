      "thumbnailUrl": "https://i.guim.co.uk/img/media/3cedcd0052d5d77e40de99a6c47f875727959bb1/0_109_2455_1964/master/2455.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=3b0fd863dc034b2992586da9ea75743b&quality=85&auto=format&fit=max",
      "originalImageUrl": "https://i.guim.co.uk/img/media/3cedcd0052d5d77e40de99a6c47f875727959bb1/0_109_2455_1964/master/2455.jpg?width=1000&amp%3Bquality=85&amp%3Bauto=format&amp%3Bfit=max&amp%3Bs=3b0fd863dc034b2992586da9ea75743b&quality=85&auto=format&fit=max",
