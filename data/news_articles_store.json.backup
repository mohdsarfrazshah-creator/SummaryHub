      "currentAffairsCategory": "Sports",
      "publishDate": "2026-10-31T22:41:08.000Z",
      "publishedAt": "2026-10-31T22:41:08.000Z",
      "firstSeenAt": "2026-11-01T04:59:15.864Z",
      "lastCheckedAt": "2026-11-01T05:06:57.163Z",
      "contentHash": "3bb52b0ac6b34479",
      "isUpdate": false,
